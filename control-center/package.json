    "smoke:truth": "node scripts/snapshot-truth.qa.mjs",
    "smoke:office": "node scripts/smoke-office.mjs",
    "smoke:security": "node --test scripts/security-boundary.node.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
